; Engine configuration file.
; Godot 4.7.2 stable, original Tiny Turbo Racers 3D.
config_version=5

[application]

config/name="Tiny Turbo Racers 3D"
run/main_scene="res://scenes/main.tscn"
config/description="A colorful offline arcade racer for families, built with Godot 4."
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=6

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.43, 0.78, 0.98, 1)

[physics]

3d/default_gravity=9.8
